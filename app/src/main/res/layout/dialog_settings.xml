<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- SEÇÃO 1: MANTER ATIVO EM SEGUNDO PLANO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_elevated"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEGUNDO PLANO E BATERIA"
                android:textColor="@color/neon_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Manter ativo em segundo plano"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtStatusBateriaConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Verificando restrição de bateria..."
                android:textColor="@color/warning_amber"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Desative a restrição de bateria do gLAN para evitar que o sistema feche a conexão LAN durante a partida."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbrirAjusteBateria"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Abrir Ajuste de Bateria"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="@color/stroke_subtle" />
        </LinearLayout>

        <!-- SEÇÃO 2: PREFERÊNCIAS DE REDE E TELA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/surface_elevated"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REDE E EXIBIÇÃO"
                android:textColor="@color/neon_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchReconectarAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:checked="true"
                android:text="Reconectar automático (Wi-Fi / 4G)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mantém você na mesma sala e no mesmo IP 10.10.0.x se a internet oscilar ou trocar entre Wi-Fi e dados móveis."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/stroke_subtle" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchMostrarTrafego"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Estatísticas de tráfego da sala"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exibe velocidade em KB/s, dados transferidos, rota e teste manual de ping na sala ativa."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/stroke_subtle" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchPingLobby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Ping automático nas salas públicas"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mede em tempo real a latência em ms de cada servidor público aberto na tela inicial."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/stroke_subtle" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAvisosSala"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Avisos de entrada e expulsão"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mostra alertas discretos quando um jogador entra, sai ou é expulso da sala."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
