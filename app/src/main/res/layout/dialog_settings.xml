<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- SEÇÃO 1: MANTER ATIVO EM SEGUNDO PLANO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_item_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="SEGUNDO PLANO E BATERIA"
                android:textColor="@color/neon_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="Manter ativo em segundo plano"
                android:textColor="@color/text_primary"
                android:textSize="14.5sp" />

            <TextView
                android:id="@+id/txtStatusBateriaConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Verificando restrição de bateria..."
                android:textColor="@color/warning_amber"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingExtra="2dp"
                android:text="Desative a restrição de bateria do gLAN para evitar que o Android encerre o túnel LAN durante a partida."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbrirAjusteBateria"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Abrir Ajuste de Bateria"
                android:textAllCaps="false"
                android:textColor="@color/neon_cyan"
                android:textSize="12.5sp"
                app:backgroundTint="#1438BDF8"
                app:cornerRadius="11dp"
                app:strokeColor="#3338BDF8" />
        </LinearLayout>

        <!-- SEÇÃO 2: SEGURANÇA, REDE E EXIBIÇÃO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_item_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="SEGURANÇA, REDE E EXIBIÇÃO"
                android:textColor="@color/neon_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchProtegerIpPublico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:fontFamily="sans-serif-medium"
                android:text="Proteção de IP em salas públicas"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/txtDescProtegerIpPublico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="Usa exclusivamente a Ponte TLS ao criar ou entrar em salas públicas, mantendo seu IP real oculto para desconhecidos."
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/divider_hairline" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchReconectarAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:fontFamily="sans-serif-medium"
                android:text="Reconectar automático (Wi-Fi / 4G)"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="Mantém você na mesma sala e no mesmo IP 10.10.0.x se a internet oscilar ou trocar entre Wi-Fi e dados móveis."
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/divider_hairline" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchMostrarTrafego"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:fontFamily="sans-serif-medium"
                android:text="Estatísticas de tráfego da sala"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="Exibe velocidade em KB/s, dados transferidos, rota e teste manual de ping na sala ativa."
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/divider_hairline" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchPingLobby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:fontFamily="sans-serif-medium"
                android:text="Ping automático nas salas públicas"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="Mede em tempo real a latência em ms de cada servidor público aberto na tela inicial."
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/divider_hairline" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAvisosSala"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:fontFamily="sans-serif-medium"
                android:text="Avisos de entrada e expulsão"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="Mostra alertas discretos quando um jogador entra, sai ou é expulso da sala."
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
