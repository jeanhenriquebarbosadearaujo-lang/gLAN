<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_item_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <FrameLayout
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:background="@drawable/bg_pill_capsule"
        android:backgroundTint="#1F38BDF8">

        <View
            android:id="@+id/viewDotSala"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_status_dot" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtTituloSalaPublica"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Sala Pública"
            android:textColor="@color/text_primary"
            android:textSize="14.5sp" />

        <TextView
            android:id="@+id/txtSubtituloSalaPublica"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Host: Jogador • IP Oculto"
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp" />

        <LinearLayout
            android:id="@+id/layoutBadgesSalaPublica"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtJogoAbertoSalaPublica"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_capsule"
                android:backgroundTint="#2410B981"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="Partida Aberta"
                android:textColor="@color/status_online"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtMapaModoSalaPublica"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_metric"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:maxWidth="136dp"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="gm_construct"
                android:textColor="@color/neon_cyan"
                android:textSize="9.5sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/txtPingSalaPublica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_chip_metric"
        android:fontFamily="monospace"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp"
        android:text="-- ms"
        android:textColor="@color/text_secondary"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtVagasSalaPublica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_chip_metric"
        android:fontFamily="monospace"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp"
        android:text="1/8"
        android:textColor="@color/neon_cyan"
        android:textSize="11sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEntrarSalaPublica"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0"
        android:minWidth="0dp"
        android:paddingHorizontal="14dp"
        android:text="Entrar"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="12.5sp"
        app:backgroundTint="@color/neon_emerald"
        app:cornerRadius="10dp" />

</LinearLayout>
