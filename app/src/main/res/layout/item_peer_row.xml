<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_item_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <FrameLayout
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:background="@drawable/bg_pill_capsule"
        android:backgroundTint="#1F10B981">

        <View
            android:id="@+id/viewStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_status_dot" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtNomeParticipante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:maxWidth="135dp"
                android:text="Jogador"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtCargoParticipante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_capsule"
                android:letterSpacing="0.04"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="JOGADOR"
                android:textColor="@color/neon_cyan"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtInfoRedeParticipante"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="monospace"
            android:text="10.10.0.2 • IP Oculto"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtPingParticipante"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_chip_metric"
        android:fontFamily="monospace"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp"
        android:text="24 ms"
        android:textColor="@color/neon_cyan"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemoverParticipante"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0"
        android:minWidth="0dp"
        android:paddingHorizontal="10dp"
        android:text="Expulsar"
        android:textAllCaps="false"
        android:textColor="@color/danger_red"
        android:textSize="11.5sp"
        app:backgroundTint="#14EF4444"
        app:cornerRadius="9dp"
        app:icon="@drawable/ic_person_remove"
        app:iconPadding="4dp"
        app:iconSize="13dp"
        app:iconTint="@color/danger_red"
        app:strokeColor="#4DEF4444" />

</LinearLayout>
